{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PrivateObjectStorage",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::REPLACE_PRIVATE_BUCKET/*",
        "arn:aws:s3:::REPLACE_QUARANTINE_BUCKET/*"
      ]
    },
    {
      "Sid": "SesSendFromAccount",
      "Effect": "Allow",
      "Action": ["ses:SendEmail", "ses:SendRawEmail"],
      "Resource": "arn:aws:ses:ap-south-1:ACCOUNT_ID:identity/builtglory.com"
    },
    {
      "Sid": "ReadAppSecrets",
      "Effect": "Allow",
      "Action": ["secretsmanager:GetSecretValue"],
      "Resource": "arn:aws:secretsmanager:ap-south-1:ACCOUNT_ID:secret:builtglory/ENVIRONMENT/*"
    },
    {
      "Sid": "WriteAppLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:ap-south-1:ACCOUNT_ID:log-group:/builtglory/ENVIRONMENT/*"
    }
  ]
}
