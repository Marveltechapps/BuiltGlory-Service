{
  "name": "builtglory-backend",
  "version": "1.0.0",
  "description": "Production-ready BuiltGlory Node.js Express MongoDB backend",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "dev:tunnel": "node scripts/dev-cloudflare-tunnel.mjs",
    "start": "node src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:automation": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand src/tests/automation",
    "test:coverage": "npm test -- --coverage",
    "openapi": "node src/docs/write-openapi.js",
    "jobs:run": "node src/jobs/runner.js",
    "push:check": "node scripts/push-check.js",
    "seed": "node scripts/seed.js",
    "seed:push": "node scripts/seed-push-notification-test-data.js",
    "test:push-api": "node scripts/run-push-notification-tests.js",
    "migrate": "node scripts/migrate.js",
    "env:harden": "node scripts/harden-local-env.mjs",
    "env:validate:prod": "node scripts/validate-production-env.mjs --file .env.production",
    "env:validate:prod:example": "node scripts/validate-production-env.mjs --file .env.production.example",
    "env:validate:staging:example": "node scripts/validate-production-env.mjs --file .env.staging.example",
    "check:integrations": "node scripts/check-integrations.mjs",
    "check:redis-sessions": "node scripts/verify-redis-sessions.mjs",
    "check:redis-lifecycle": "node scripts/check-redis-lifecycle.mjs",
    "check:redis-startup": "node scripts/check-redis-startup.mjs",
    "check:ses": "node scripts/ses-status.mjs",
    "email:test:controlled": "node scripts/send-controlled-test-email.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1073.0",
    "@aws-sdk/client-ses": "^3.1171.0",
    "@aws-sdk/s3-request-presigner": "^3.1073.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "firebase-admin": "^14.1.0",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.3",
    "multer": "^2.2.0",
    "node-cron": "^4.5.0",
    "nodemailer": "^10.6.0",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "uuid": "^14.0.1",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/supertest": "^7.2.1",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2"
  },
  "nodemonConfig": {
    "delay": 500,
    "signal": "SIGTERM",
    "watch": [
      "src"
    ],
    "ext": "js,json",
    "ignore": [
      "src/tests/**",
      "coverage/**",
      "scripts/**"
    ]
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
