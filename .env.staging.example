# Staging template. Copy to the staging host environment. Never commit the filled file.
# Validate with: npm run env:validate:staging:example
#
# Staging must not reuse production database, Redis, S3, CORS, or secrets.
# Hostnames below are proposed names. They are not live DNS records.

NODE_ENV=staging
PORT=5001

MONGODB_URI=mongodb+srv://USER:PASS@STAGING_CLUSTER/builtglory_staging?retryWrites=true&w=majority
MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8

REDIS_URL=rediss://default:PASS@STAGING_REDIS_HOST:6379
REDIS_TLS_REJECT_UNAUTHORIZED=true

JWT_ACCESS_SECRET=REPLACE_WITH_STAGING_ACCESS_SECRET_AT_LEAST_48_CHARS_LONG_XX
JWT_REFRESH_SECRET=REPLACE_WITH_STAGING_REFRESH_SECRET_AT_LEAST_48_CHARS_LONG_YY
JWT_ISSUER=builtglory-api
JWT_AUDIENCE=builtglory-clients
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
ADMIN_INACTIVITY_SECONDS=1800

CORS_ORIGINS=https://staging-app.builtglory.com,https://staging-admin.builtglory.com
APP_PUBLIC_URL=https://staging-api.builtglory.com

AWS_REGION=ap-south-1
AWS_S3_BUCKET=builtglory-staging-private
AWS_USE_INSTANCE_ROLE=false
AWS_ACCESS_KEY_ID=REPLACE
AWS_SECRET_ACCESS_KEY=REPLACE
QUARANTINE_S3_BUCKET=builtglory-staging-quarantine

# Keep staging SMS in log mode until a separate vendor account is approved.
SMS_DELIVERY_MODE=log
SMS_VENDOR_URL=https://login4.spearuc.com/MOBILE_APPS_API/sms_api.php?type=smsquicksend&user=REPLACE&pass=REPLACE&sender=REPLACE&
SMS_OTP_MESSAGE_TEMPLATE=Your BuiltGlory verification code is {otp}. It expires in 5 minutes.

EMAIL_TRANSPORT=ses
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=REPLACE_IF_USING_SMTP
SMTP_PASS=REPLACE_IF_USING_SMTP
EMAIL_FROM=noreply@builtglory.com
ADMIN_EMAIL=admin@builtglory.com

FIREBASE_PROJECT_ID=REPLACE
FIREBASE_CLIENT_EMAIL=REPLACE@REPLACE.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE\n-----END PRIVATE KEY-----\n"

COMPANY_SUPPORT_PHONE=+91 8667769670
COMPANY_SUPPORT_EMAIL=support@builtglory.com
