# Production template. Copy to .env.production and fill real values.
# Never commit .env.production. Validate with:
#   npm run env:validate:prod
#
# Rejected by validation: localhost, http:// CORS, weak JWT, redis:// (non-TLS),
# in-memory Redis, Gmail SMTP, S3 ARN bucket names.

NODE_ENV=production
PORT=5001

# Managed MongoDB replica set (not localhost)
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER/builtglory?retryWrites=true&w=majority
MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8

# Managed Redis with TLS — required in production (rediss://, not redis://, not localhost)
REDIS_URL=rediss://default:PASS@HOST:6379
REDIS_TLS_REJECT_UNAUTHORIZED=true

# Cryptographically strong unique secrets (>=48 chars). Generate separately; do not reuse.
JWT_ACCESS_SECRET=REPLACE_WITH_CRYPTO_RANDOM_ACCESS_SECRET_AT_LEAST_48_CHARS_LONG_XX
JWT_REFRESH_SECRET=REPLACE_WITH_CRYPTO_RANDOM_REFRESH_SECRET_AT_LEAST_48_CHARS_LONG_YY
JWT_ISSUER=builtglory-api
JWT_AUDIENCE=builtglory-clients
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
ADMIN_INACTIVITY_SECONDS=1800

# HTTPS Dashboard / Web origins only. No localhost. No wildcards. No http://
CORS_ORIGINS=https://admin.builtglory.com,https://app.builtglory.com

# Public API / deep links (HTTPS)
APP_PUBLIC_URL=https://api.builtglory.com

# Object storage — bucket NAME only (not ARN).
# On EC2/ECS, prefer an instance/task role and set AWS_USE_INSTANCE_ROLE=true
# with the access key variables empty. Do not commit real keys.
AWS_REGION=ap-south-1
AWS_S3_BUCKET=buildglory-version3
AWS_USE_INSTANCE_ROLE=false
AWS_ACCESS_KEY_ID=REPLACE
AWS_SECRET_ACCESS_KEY=REPLACE

# SMS (vendor mode required in production — never "log")
SMS_DELIVERY_MODE=vendor
SMS_VENDOR_URL=https://login4.spearuc.com/MOBILE_APPS_API/sms_api.php?type=smsquicksend&user=REPLACE&pass=REPLACE&sender=REPLACE&
SMS_OTP_MESSAGE_TEMPLATE=Your BuiltGlory verification code is {otp}. It expires in 5 minutes.

# Email — Amazon SES (required for production; Gmail SMTP is rejected)
EMAIL_TRANSPORT=ses
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=REPLACE_IF_USING_SMTP
SMTP_PASS=REPLACE_IF_USING_SMTP
EMAIL_FROM=noreply@builtglory.com
ADMIN_EMAIL=admin@builtglory.com

# Push
FIREBASE_PROJECT_ID=REPLACE
FIREBASE_CLIENT_EMAIL=REPLACE@REPLACE.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE\n-----END PRIVATE KEY-----\n"

COMPANY_SUPPORT_PHONE=+91 8667769670
COMPANY_SUPPORT_EMAIL=support@builtglory.com
